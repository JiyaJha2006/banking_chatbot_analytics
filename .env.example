# App server
HOST=127.0.0.1
PORT=8000
OPEN_BROWSER=1

# Use mysql locally. Use sqlite for free Hugging Face deployment.
DATABASE_BACKEND=mysql

# Option 1: one database URL secret
# MYSQL_URL=mysql://root:root123@localhost:3306/banking_chatbot_db

# Option 2: separate MySQL secrets
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root123
MYSQL_DATABASE=banking_chatbot_db

# SQLite deploy mode
SQLITE_DB_PATH=data/chatbot_app.sqlite3
